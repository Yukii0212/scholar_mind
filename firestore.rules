rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ]);

      match /folders/{folderId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && validFolder(request.resource.data);
        allow update: if isOwner(userId)
          && validFolder(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && validNote(request.resource.data);
      }
    }

    function validFolder(data) {
      return data.keys().hasAll([
          'name',
          'parentId',
          'isFavorite',
          'isArchived',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'parentId',
          'isFavorite',
          'isArchived',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.parentId is string
        && data.isFavorite is bool
        && data.isArchived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validNote(data) {
      return data.keys().hasAll([
          'name',
          'folderId',
          'storagePath',
          'extension',
          'sizeBytes',
          'category',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'folderId',
          'storagePath',
          'extension',
          'sizeBytes',
          'category',
          'source',
          'classroomCourseId',
          'classroomMaterialId',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.folderId is string
        && data.storagePath is string
        && data.extension is string
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && data.sizeBytes < 10 * 1024 * 1024
        && data.category in [
          'lectureNotes',
          'selfStudyNotes',
          'pastYearQuestions'
        ]
        && data.source in ['manual', 'classroom']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
  }
}
