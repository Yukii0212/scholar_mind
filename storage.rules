rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Shared export archives: readable by any signed-in user (that's how
    // another user's import flow fetches the archive.json for a share
    // link), but only the owner can upload/overwrite/delete their own.
    // Capped higher than a single note (50MB) since one archive can bundle
    // several notes' embedded file bytes together, not just one file.
    match /users/{userId}/shared_exports/{shareId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
