rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Shared export archives: readable by any signed-in user (that's how
    // another user's import flow fetches the archive.json for a share
    // link, plus each note's own file underneath .../files/), but only
    // the owner can upload/overwrite/delete their own. archive.json
    // itself stays small (references, not file bytes); this cap is really
    // about the individual file objects under .../files/, so it's set
    // above the per-note upload cap below rather than at it.
    match /users/{userId}/shared_exports/{shareId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
