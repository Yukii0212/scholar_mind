rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsSemester(semesterId, courseCreatedAt) {
      return isSignedIn()
        && semesterId is string
        && courseCreatedAt is timestamp
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/semesters/$(semesterId)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/semesters/$(semesterId)
        ).data.createdAt <= courseCreatedAt;
    }

    function ownsCourse(courseId) {
      return isSignedIn()
        && courseId is string
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ]);

      match /folders/{folderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validFolder(request.resource.data);
      }

      match /notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validNote(request.resource.data);
      }

      match /settings/{settingsId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && settingsId == 'app'
          && validAppSettings(request.resource.data);
      }

      match /study_streak/{streakId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && streakId == 'summary'
          && validStudyStreak(request.resource.data);
      }

      match /countdowns/{countdownId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validCountdown(request.resource.data);
      }

      match /flashcard_folders/{folderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validFlashcardFolder(request.resource.data);
      }

      match /flashcard_decks/{deckId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validFlashcardDeck(request.resource.data);

        match /cards/{cardId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && validFlashcard(request.resource.data);
        }

        match /sessions/{sessionId} {
          allow read, delete: if isOwner(userId);
          allow create: if isOwner(userId)
            && validFlashcardSession(request.resource.data);
          // Session records are a per-attempt log, not something you
          // edit after the fact.
          allow update: if false;
        }
      }

      match /quiz_folders/{folderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validQuizFolder(request.resource.data);
      }

      match /quizzes/{quizId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validQuiz(request.resource.data);
      }

      // Questions the user flagged as "Not important" from a completed
      // quiz -- unbounded (the user can keep everything they've ever
      // flagged, not just a recent slice), used both to show them what
      // they've flagged and to steer future generations away from
      // similar questions.
      match /quizFeedback/{feedbackId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && validQuizFeedback(request.resource.data);
      }

      match /semesters/{semesterId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && validSemester(request.resource.data)
          && request.resource.data.id == semesterId
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && validSemester(request.resource.data)
          && request.resource.data.id == semesterId
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    // Courses are top-level for historical reasons. A course's semesterId
    // points to a semester under its owner's /users/{uid} tree, which is the
    // ownership signal used only while legacy documents are being backfilled.
    match /courses/{courseId} {
      allow read: if isSignedIn()
        && ((('ownerId' in resource.data)
            && resource.data.ownerId == request.auth.uid)
          || ownsSemester(
            resource.data.semesterId,
            resource.data.createdAt
          ));
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && ownsSemester(
          request.resource.data.semesterId,
          request.resource.data.createdAt
        )
        && validCourse(request.resource.data);
      allow update: if isSignedIn()
        && validCourse(request.resource.data)
        && (
          (
            ('ownerId' in resource.data)
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && ownsSemester(
              request.resource.data.semesterId,
              request.resource.data.createdAt
            )
          )
          || isLegacyCourseOwnerBackfill()
        );

      match /assessmentEntries/{entryId} {
        allow read, delete: if isSignedIn()
          && get(/databases/$(database)/documents/courses/$(courseId))
            .data.ownerId == request.auth.uid;
        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/courses/$(courseId))
            .data.ownerId == request.auth.uid
          && validAssessmentEntry(request.resource.data);
      }
    }

    match /grading_components/{componentId} {
      allow read: if isSignedIn()
        && ((('ownerId' in resource.data)
            && resource.data.ownerId == request.auth.uid)
          || ownsCourse(resource.data.courseId));
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && ownsCourse(request.resource.data.courseId)
        && validGradingComponent(request.resource.data);
      allow update: if isSignedIn()
        && validGradingComponent(request.resource.data)
        && (
          (
            ('ownerId' in resource.data)
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && ownsCourse(request.resource.data.courseId)
          )
          || isLegacyComponentOwnerBackfill()
        );
    }

    // Share links: readable by any signed-in user (the whole point is that
    // someone else looks the id up to import it), but only the creator can
    // create, modify or revoke their own link.
    match /export_links/{shareId} {
      // get vs list are separate grants under "read" -- get is for
      // looking up one link by an id someone was given (the whole point
      // of sharing), open to any signed-in user since they don't own it.
      // list is a query (My Shared Links' watchMyLinks(), filtered by
      // ownerId) and needs its own grant, scoped so a user can only list
      // their own links, not enumerate everyone's.
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validExportLink(request.resource.data);
      // Owners can only revoke; immutable owner/path/expiry fields keep the
      // Storage authorization record trustworthy. Importers may only bump
      // downloadCount on a still-active link.
      allow update: if isOwnerRevocation()
        || isDownloadCountIncrement();
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // Immutable mapping from a shared_exports Storage directory to the
    // public export_links document that authorizes it. Keeping this separate
    // preserves existing public share ids whose Storage folder id differs.
    match /export_storage_access/{storageShareId} {
      allow get: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validExportStorageAccess(
          request.resource.data,
          storageShareId
        );
      allow update, delete: if false;
    }

    function validFolder(data) {
      return data.keys().hasAll([
          'name',
          'parentId',
          'isFavorite',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'parentId',
          'isFavorite',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.parentId is string
        && data.isFavorite is bool
        && data.isArchived is bool
        && data.isDeleted is bool
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // hasAll lists only the fields every note-creation path in the app
    // guarantees (uploadNote / importInternalNote / importUploadedNote /
    // createInternalNote don't all set the same fields -- e.g.
    // createInternalNote omits updatedAt/cacheExpiresAt/lock* at creation,
    // uploadNote omits isInternal/content). hasOnly is the union of every
    // field any of those paths ever writes.
    function validNote(data) {
      return data.keys().hasAll([
          'name',
          'folderId',
          'storagePath',
          'extension',
          'sizeBytes',
          'category',
          'source',
          'isFavorite',
          'isDeleted',
          'deletedAt',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'name',
          'folderId',
          'storagePath',
          'extension',
          'sizeBytes',
          'category',
          'source',
          'isFavorite',
          'isDeleted',
          'isInternal',
          'content',
          'deletedAt',
          'cacheExpiresAt',
          'lockedBy',
          'heartbeatAt',
          'lockExpiresAt',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.folderId is string
        && data.storagePath is string
        && data.extension is string
        && data.sizeBytes is int
        && data.sizeBytes >= 0
        && data.sizeBytes < 10 * 1024 * 1024
        && data.category in [
          'lectureNotes',
          'selfStudyNotes',
          'pastYearQuestions'
        ]
        && data.source is string
        && data.source.size() > 0
        && data.isFavorite is bool
        && data.isDeleted is bool
        && data.createdAt is timestamp;
    }

    function validAppSettings(data) {
      return data.keys().hasAll(['selected_theme', 'updated_at'])
        && data.keys().hasOnly(['selected_theme', 'updated_at'])
        && data.selected_theme in [
          'scholar_blue',
          'sakura_pink',
          'midnight'
        ]
        && data.updated_at is timestamp;
    }

    function validStudyStreak(data) {
      return data.keys().hasAll([
          'currentStreak',
          'longestStreak',
          'totalStudyDays',
          'lastStudyDate',
          'monthlyActivity',
          'dailyActivity',
          'achievements',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'currentStreak',
          'longestStreak',
          'totalStudyDays',
          'lastStudyDate',
          'monthlyActivity',
          'dailyActivity',
          'achievements',
          'updatedAt'
        ])
        && data.currentStreak is int
        && data.longestStreak is int
        && data.totalStudyDays is int
        && data.lastStudyDate is string
        && data.monthlyActivity is map
        && data.dailyActivity is map
        && data.achievements is list
        && data.updatedAt is timestamp;
    }

    function validCountdown(data) {
      return data.keys().hasAll([
          'title',
          'type',
          'priority',
          'dueDate',
          'description',
          'deadlineExtendable',
          'isCompleted',
          'isHidden',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'type',
          'priority',
          'dueDate',
          'description',
          'deadlineExtendable',
          'isCompleted',
          'isHidden',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.type in [
          'assignment',
          'quiz',
          'lab',
          'presentation',
          'project',
          'midterm',
          'final_examination',
          'personal',
          'other'
        ]
        && data.priority is int
        && data.dueDate is timestamp
        && (data.description == null || data.description is string)
        && data.deadlineExtendable is bool
        && data.isCompleted is bool
        && data.isHidden is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFlashcardDeck(data) {
      return data.keys().hasAll([
          'name',
          'tags',
          'generationMethod',
          'sourceReference',
          'description',
          'cardCount',
          'sessionsCompleted',
          'cardsReviewed',
          'knownCards',
          'needsReviewCards',
          'folderId',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'deletedAsCascade',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'tags',
          'generationMethod',
          'sourceReference',
          'description',
          'cardCount',
          'sessionsCompleted',
          'cardsReviewed',
          'knownCards',
          'needsReviewCards',
          'folderId',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'deletedAsCascade',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.tags is list
        && data.generationMethod in ['manual', 'aiGenerated']
        && (data.sourceReference == null || data.sourceReference is string)
        && (data.description == null || data.description is string)
        && data.cardCount is int
        && data.sessionsCompleted is int
        && data.cardsReviewed is int
        && data.knownCards is int
        && data.needsReviewCards is int
        && data.folderId is string
        && data.isArchived is bool
        && data.isDeleted is bool
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.deletedAsCascade is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFlashcardFolder(data) {
      return data.keys().hasAll([
          'name',
          'parentId',
          'isDeleted',
          'deletedAt',
          'deletedAsCascade',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'parentId',
          'isDeleted',
          'deletedAt',
          'deletedAsCascade',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.parentId is string
        && data.isDeleted is bool
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.deletedAsCascade is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFlashcard(data) {
      return data.keys().hasAll([
          'front',
          'back',
          'tags',
          'frontImageUrl',
          'backImageUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'front',
          'back',
          'tags',
          'frontImageUrl',
          'backImageUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.front is string
        && data.front.size() > 0
        && data.front.size() <= 5000
        && data.back is string
        && data.back.size() > 0
        && data.back.size() <= 10000
        && data.tags is list
        && (data.frontImageUrl == null || data.frontImageUrl is string)
        && (data.backImageUrl == null || data.backImageUrl is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFlashcardSession(data) {
      return data.keys().hasAll([
          'reviewed',
          'known',
          'needsReview',
          'missedCardIds',
          'completedAt'
        ])
        && data.keys().hasOnly([
          'reviewed',
          'known',
          'needsReview',
          'missedCardIds',
          'completedAt'
        ])
        && data.reviewed is int
        && data.known is int
        && data.needsReview is int
        && data.missedCardIds is list
        && data.completedAt is timestamp;
    }

    function validQuizFolder(data) {
      return data.keys().hasAll([
          'name',
          'parentId',
          'isFavorite',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'parentId',
          'isFavorite',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.parentId is string
        && data.isFavorite is bool
        && data.isArchived is bool
        && data.isDeleted is bool
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Quiz attempts serialize their own dates as ISO-8601 strings
    // (QuizAttempt.toJson()), not Firestore timestamps -- unlike almost
    // everything else in this file.
    function validQuiz(data) {
      return data.keys().hasAll([
          'id',
          'status',
          'name',
          'folderId',
          'createdAt',
          'updatedAt',
          'isFavorite',
          'isArchived',
          'isDeleted',
          'startedAt',
          'quiz',
          'answers'
        ])
        && data.keys().hasOnly([
          'id',
          'status',
          'name',
          'folderId',
          'createdAt',
          'updatedAt',
          'isFavorite',
          'isArchived',
          'isDeleted',
          'deletedAt',
          'startedAt',
          'submittedAt',
          'completedAt',
          'quiz',
          'answers'
        ])
        && data.id is string
        && data.status in ['inProgress', 'grading', 'completed', 'archived']
        && data.name is string
        && data.folderId is string
        && data.createdAt is string
        && data.updatedAt is string
        && data.isFavorite is bool
        && data.isArchived is bool
        && data.isDeleted is bool
        && data.startedAt is string
        && data.quiz is map
        && data.answers is map;
    }

    function validQuizFeedback(data) {
      return data.keys().hasAll(['questionText', 'questionType', 'createdAt'])
        && data.keys().hasOnly(
          ['questionText', 'questionType', 'reason', 'createdAt']
        )
        && data.questionText is string
        && data.questionText.size() > 0
        && data.questionType is string
        && (data.reason == null || data.reason is string)
        && data.createdAt is timestamp;
    }

    function validSemester(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'startDate',
          'endDate',
          'isCurrent',
          'isManuallyEdited',
          'isHidden',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'startDate',
          'endDate',
          'isCurrent',
          'isManuallyEdited',
          'isHidden',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.isCurrent is bool
        && data.isManuallyEdited is bool
        && data.isHidden is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isLegacyCourseOwnerBackfill() {
      return (!('ownerId' in resource.data)
          || (('ownerId' in resource.data)
            && resource.data.ownerId == ''))
        && ownsSemester(
          resource.data.semesterId,
          resource.data.createdAt
        )
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['ownerId']);
    }

    function isLegacyComponentOwnerBackfill() {
      return (!('ownerId' in resource.data)
          || (('ownerId' in resource.data)
            && resource.data.ownerId == ''))
        && ownsCourse(resource.data.courseId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['ownerId']);
    }

    function validCourse(data) {
      return data.keys().hasAll([
          'ownerId',
          'semesterId',
          'name',
          'targetScore',
          'minimumAcceptableScore',
          'passingScore',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'semesterId',
          'name',
          'targetScore',
          'minimumAcceptableScore',
          'passingScore',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.semesterId is string
        && data.name is string
        && data.name.size() > 0
        && (data.targetScore == null || data.targetScore is number)
        && (data.minimumAcceptableScore == null
          || data.minimumAcceptableScore is number)
        && data.passingScore is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validGradingComponent(data) {
      return data.keys().hasAll([
          'ownerId',
          'courseId',
          'parentId',
          'name',
          'weight',
          'order',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'courseId',
          'parentId',
          'name',
          'weight',
          'order',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.courseId is string
        && (data.parentId == null || data.parentId is string)
        && data.name is string
        && data.name.size() > 0
        && data.weight is number
        && data.order is int
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validAssessmentEntry(data) {
      return data.keys().hasAll([
          'courseId',
          'componentId',
          'type',
          'score',
          'denominator',
          'percentage',
          'interpretation',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'courseId',
          'componentId',
          'type',
          'score',
          'denominator',
          'percentage',
          'interpretation',
          'createdAt',
          'updatedAt'
        ])
        && data.courseId is string
        && data.componentId is string
        && data.type in ['actual', 'expected']
        && data.score is number
        && data.denominator is number
        && data.percentage is number
        && data.interpretation in [
          'percentage',
          'componentWeight',
          'overallWeight',
          'custom',
          'ambiguous'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isDownloadCountIncrement() {
      return isSignedIn()
        && resource.data.isRevoked == false
        && (resource.data.expiresAt == null
          || request.time < resource.data.expiresAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
        && request.resource.data.downloadCount == resource.data.downloadCount + 1;
    }

    function isOwnerRevocation() {
      return isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.isRevoked == true
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['isRevoked']);
    }

    function validExportLink(data) {
      return data.keys().hasAll([
          'ownerId',
          'storagePath',
          'createdAt',
          'expiresAt',
          'downloadCount',
          'isRevoked',
          'resourceCounts'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'storagePath',
          'createdAt',
          'expiresAt',
          'downloadCount',
          'isRevoked',
          'resourceCounts'
        ])
        && data.ownerId is string
        && data.storagePath is string
        && data.resourceCounts is map
        && (data.createdAt == null || data.createdAt is timestamp)
        && (data.expiresAt == null || data.expiresAt is timestamp)
        && data.downloadCount is int
        && data.isRevoked is bool;
    }

    function validExportStorageAccess(data, storageShareId) {
      return data.keys().hasAll([
          'ownerId',
          'shareLinkId',
          'storagePath'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'shareLinkId',
          'storagePath'
        ])
        && data.ownerId is string
        && data.shareLinkId is string
        && data.storagePath == 'users/' + data.ownerId
          + '/shared_exports/' + storageShareId + '/archive.json'
        && getAfter(
          /databases/$(database)/documents/export_links/$(data.shareLinkId)
        ).data.ownerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/export_links/$(data.shareLinkId)
        ).data.storagePath == data.storagePath;
    }
  }
}
