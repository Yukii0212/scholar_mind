rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasActiveShareAccess(userId, storageShareId) {
      let access = firestore.get(
        /databases/(default)/documents/export_storage_access/$(storageShareId)
      );
      let link = firestore.get(
        /databases/(default)/documents/export_links/$(access.data.shareLinkId)
      );

      return isSignedIn()
        && access.data.ownerId == userId
        && access.data.storagePath == 'users/' + userId
          + '/shared_exports/' + storageShareId + '/archive.json'
        && link.data.ownerId == userId
        && link.data.storagePath == access.data.storagePath
        && link.data.isRevoked == false
        && (link.data.expiresAt == null
          || request.time < link.data.expiresAt);
    }

    // Importers may read only while the mapped Firestore share link remains
    // active. Owners retain access so uploads and cleanup are not blocked by
    // the link lifecycle.
    match /users/{userId}/shared_exports/{shareId}/{allPaths=**} {
      allow read: if isOwner(userId)
        || hasActiveShareAccess(userId, shareId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
